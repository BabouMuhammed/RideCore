NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/ridecore?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:3000

# Optional MVP feature settings (defaults shown)
DRIVER_SEARCH_RADIUS_KM=10
LOCATION_PERSIST_INTERVAL_MS=5000
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Temporary ride-specific trusted-person sharing
RIDE_SHARE_TTL_SECONDS=14400
RIDE_SHARE_RATE_LIMIT_MAX=120
