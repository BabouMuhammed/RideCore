{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "demo": {
      "extends": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "local-demo": {
      "extends": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_ALLOW_SERVER_SETTING": "true"
      }
    }
  }
}
