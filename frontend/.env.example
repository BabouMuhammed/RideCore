# Public runtime configuration. Never put secrets here.
# Native Expo does not read VITE_ variables.
# Use the backend host reachable from the Android device, always port 5050.
EXPO_PUBLIC_API_URL=

# Android emulator API example: http://10.0.2.2:5050/api
# Physical devices require a reachable host address. Release builds require HTTPS.

# Reachable web host for unauthenticated recipient links; no private credentials.
EXPO_PUBLIC_SHARE_WEB_URL=

# Optional: start with a local sample account and simulated rides.
EXPO_PUBLIC_DEMO_MODE=false
# Maps are free OpenStreetMap services; no key needed. Optional self-hosted overrides:
EXPO_PUBLIC_MAP_TILE_URL=
EXPO_PUBLIC_GEOCODER_URL=
EXPO_PUBLIC_ROUTER_URL=
